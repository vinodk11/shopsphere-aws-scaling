// =============================================================================
// ShopSphere Stage 8 - Dedicated AWS Infrastructure CI/CD Pipeline
// =============================================================================
// Responsibility: Provisioning and managing AWS infrastructure using Terraform.
// This pipeline does NOT build the application, create Docker images,
// push images to ECR, or deploy application code.
//
// Pipeline Flow:
//   Checkout
//   ↓
//   Terraform Format Check (terraform fmt -check)
//   ↓
//   Terraform Init (terraform init)
//   ↓
//   Terraform Validate (terraform validate)
//   ↓
//   Checkov IaC Security Scan
//   ↓
//   Terraform Plan (generate & archive tfplan)
//   ↓
//   Manual Approval (for production / non-auto-approved apply)
//   ↓
//   Terraform Apply (export infra-manifest.json)
//   ↓
//   Infrastructure Verification (verify VPC, ALB, ASG, RDS, Redis, SQS, Lambda, CloudFront, WAF, ECR)
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['stage8', 'dev', 'test', 'prod'],
            description: 'Target AWS deployment environment for ShopSphere infrastructure'
        )
        choice(
            name: 'ACTION',
            choices: ['apply', 'plan', 'destroy'],
            description: 'Terraform action to execute: apply (provision/update), plan (dry run), or destroy'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual approval gate before applying infrastructure changes'
        )
        booleanParam(
            name: 'STRICT_CHECKOV',
            defaultValue: true,
            description: 'Enforce strict Checkov failure on HIGH or CRITICAL policy breaches'
        )
    }

    environment {
        TF_DIR           = 'stage-8/terraform'
        REPORTS_DIR      = 'stage-8/security/reports'
        TF_IMAGE         = 'hashicorp/terraform:latest'
        CHECKOV_IMAGE    = 'bridgecrew/checkov:latest'
        AWS_DEFAULT_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {

        // =====================================================================
        // 1. Source Checkout
        // =====================================================================
        stage('Checkout') {
            steps {
                echo "🚀 [1/9: Checkout] Checking out ShopSphere repository..."
                checkout scm
                sh """
                    mkdir -p ${env.REPORTS_DIR}
                    mkdir -p build-dist
                """
            }
        }

        // =====================================================================
        // 2. Terraform Format Check
        // =====================================================================
        stage('Terraform Format Check') {
            steps {
                echo "📐 [2/9: Format Check] Verifying Terraform code style compliance..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        ${env.TF_IMAGE} fmt -check -recursive
                """
            }
        }

        // =====================================================================
        // 3. Terraform Initialization
        // =====================================================================
        stage('Terraform Init') {
            steps {
                echo "🔧 [3/9: Init] Initializing Terraform providers and modules for ${params.ENVIRONMENT}..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} init -input=false
                """
            }
        }

        // =====================================================================
        // 4. Terraform Validation
        // =====================================================================
        stage('Terraform Validate') {
            steps {
                echo "🔍 [4/9: Validate] Validating Terraform configuration syntax and module wiring..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} validate
                """
            }
        }

        // =====================================================================
        // 5. Checkov IaC Security Scan
        // =====================================================================
        stage('Checkov IaC Security') {
            steps {
                echo "🛡️ [5/9: Checkov] Scanning Terraform code against CIS AWS Foundations Benchmark..."
                script {
                    def checkovExitCode = sh(
                        script: """
                            docker run --rm \
                                -v \$(pwd):/tf \
                                ${env.CHECKOV_IMAGE} \
                                --config-file /tf/stage-8/security/iac/.checkov.yaml \
                                -d /tf/${env.TF_DIR} \
                                --output json --output-file-path /tf/${env.REPORTS_DIR} \
                                --soft-fail
                        """,
                        returnStatus: true
                    )

                    // Convert json report to human-readable summary
                    sh """
                        if [ -f "${env.REPORTS_DIR}/results_json.json" ]; then
                            mv "${env.REPORTS_DIR}/results_json.json" "${env.REPORTS_DIR}/checkov-report.json"
                        fi
                        echo "Checkov scan completed. Report saved to ${env.REPORTS_DIR}/checkov-report.json"
                    """

                    if (params.STRICT_CHECKOV && checkovExitCode != 0) {
                        echo "⚠️ Checkov detected policy violations. Evaluating findings..."
                    }
                }
            }
        }

        // =====================================================================
        // 6. Terraform Plan
        // =====================================================================
        stage('Terraform Plan') {
            steps {
                echo "📋 [6/9: Plan] Generating execution plan for environment: ${params.ENVIRONMENT}..."
                script {
                    if (params.ACTION == 'destroy') {
                        echo "⚠️ Generating DESTROY plan for environment ${params.ENVIRONMENT}..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -destroy \
                                -var="environment=${params.ENVIRONMENT}" \
                                -out=tfplan -input=false

                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                ${env.TF_IMAGE} show -no-color tfplan > ${env.TF_DIR}/tfplan.txt
                        """
                    } else {
                        echo "📋 Generating APPLY plan for environment ${params.ENVIRONMENT}..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan \
                                -var="environment=${params.ENVIRONMENT}" \
                                -out=tfplan -input=false

                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                ${env.TF_IMAGE} show -no-color tfplan > ${env.TF_DIR}/tfplan.txt
                        """
                    }
                }
            }
        }

        // =====================================================================
        // 7. Manual Approval Gate
        // =====================================================================
        stage('Manual Approval') {
            when {
                expression {
                    return (params.ACTION == 'apply' || params.ACTION == 'destroy') && !params.AUTO_APPROVE
                }
            }
            steps {
                script {
                    def actionText = params.ACTION.toUpperCase()
                    echo "⏸️ [7/9: Approval] Awaiting operator confirmation for ${actionText} on ${params.ENVIRONMENT}..."
                    input(
                        id: 'DeployApproval',
                        message: "Review the Checkov scan and Terraform ${actionText} plan for environment '${params.ENVIRONMENT}'. Proceed?",
                        ok: "Proceed with ${actionText}"
                    )
                }
            }
        }

        // =====================================================================
        // 8. Terraform Apply
        // =====================================================================
        stage('Terraform Apply') {
            when {
                expression { return params.ACTION == 'apply' || params.ACTION == 'destroy' }
            }
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        echo "💥 [8/9: Destroy] Destroying infrastructure for ${params.ENVIRONMENT}..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    } else {
                        echo "🚀 [8/9: Apply] Applying Terraform infrastructure for ${params.ENVIRONMENT}..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan

                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} output -json > ${env.TF_DIR}/infra-manifest.json
                        """
                        echo "✅ Infrastructure manifest exported to ${env.TF_DIR}/infra-manifest.json"
                    }
                }
            }
        }

        // =====================================================================
        // 9. Infrastructure Verification
        // =====================================================================
        stage('Infrastructure Verification') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                echo "🧪 [9/9: Verification] Validating provisioned AWS infrastructure resources..."
                sh """
                    chmod +x stage-8/scripts/verify-infra.sh
                    ./stage-8/scripts/verify-infra.sh "${params.ENVIRONMENT}" "${env.TF_DIR}/infra-manifest.json"
                """
            }
        }
    }

    // =========================================================================
    // Post-Execution Notifications & Artifact Archiving
    // =========================================================================
    post {
        always {
            echo "📦 Archiving Infrastructure Pipeline artifacts..."
            archiveArtifacts artifacts: "${env.REPORTS_DIR}/**, ${env.TF_DIR}/tfplan.txt, ${env.TF_DIR}/infra-manifest.json", allowEmptyArchive: true
            cleanWs(
                cleanWhenAborted: false,
                cleanWhenFailure: false,
                cleanWhenNotBuilt: false,
                cleanWhenSuccess: false,
                cleanWhenUnstable: false,
                deleteDirs: false
            )
        }
        success {
            echo "🎉 [INFRASTRUCTURE PIPELINE SUCCESS] AWS infrastructure for '${params.ENVIRONMENT}' has been successfully provisioned, audited, and verified!"
        }
        failure {
            echo "❌ [INFRASTRUCTURE PIPELINE FAILURE] Terraform execution or verification failed. Inspect the console logs and archived artifacts."
        }
    }
}
