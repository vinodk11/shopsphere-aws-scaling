{
  "name": "shopsphere-app",
  "version": "8.0.0",
  "description": "ShopSphere E-Commerce Application - Stage 8 (Docker Containerization + Multi-Stage Builds + Image Security + CloudFront + WAF + ALB + ASG + Redis + SQS + Lambda + RDS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "docker:build": "docker build -t shopsphere-app:latest .",
    "docker:run": "docker run -p 8080:8080 --env-file .env shopsphere-app:latest"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.540.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "redis": "^4.6.13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "docker",
    "containerization",
    "multi-stage",
    "devsecops",
    "ecommerce",
    "aws",
    "ecr",
    "cloudfront",
    "waf",
    "alb",
    "asg",
    "sqs",
    "lambda",
    "redis",
    "rds"
  ],
  "author": "ShopSphere Team",
  "license": "MIT"
}
