# ShopSphere Stage 5 - Application Environment Variables
PORT=8080
NODE_ENV=production
AWS_REGION=us-east-1

# Amazon RDS PostgreSQL Database Connection
DB_HOST=shopsphere-stage5-postgres.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=shopspheredb
DB_USER=shopsphere_user
DB_PASSWORD=YourSuperSecretStrongPassword123!
DB_SSL=true

# Amazon ElastiCache Redis Connection
REDIS_HOST=shopsphere-stage5-redis.xxxxxx.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_TTL_SECONDS=60

# Amazon SQS Order Processing Queue
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/shopsphere-stage5-order-queue
SQS_QUEUE_NAME=shopsphere-stage5-order-queue

# Stage Configuration
STAGE_NAME=stage-5
ARCHITECTURE_TIER=ALB-ASG-REDIS-SQS-LAMBDA-RDS
