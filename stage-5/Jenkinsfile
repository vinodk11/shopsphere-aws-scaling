pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to perform on Stage-5 (ALB + ASG + Redis + RDS + Amazon SQS + AWS Lambda)'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual confirmation before apply or destroy'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_DIR           = 'stage-5/terraform'
        TF_IMAGE         = 'hashicorp/terraform:latest'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo "🚀 Checking out ShopSphere Stage 5 repository..."
                git branch: 'main', url: 'https://github.com/vinodk11/shopsphere-aws-scaling.git'
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                echo "🔧 Running terraform init & validate via Docker container for Stage-5 (SQS + Lambda + ASG + Redis + RDS)..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} version

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} init -input=false

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} validate
                """
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        echo "⚠️ Generating DESTROY plan for Stage-5..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -destroy -out=tfplan -input=false
                        """
                    } else {
                        echo "📋 Generating execution plan for Stage-5..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -out=tfplan -input=false
                        """
                    }
                }
            }
        }

        stage('Approval Gate') {
            when {
                expression { 
                    return (params.ACTION == 'apply' || params.ACTION == 'destroy') && !params.AUTO_APPROVE 
                }
            }
            steps {
                script {
                    def actionText = params.ACTION == 'destroy' ? 'DESTROY' : 'APPLY'
                    input(
                        id: 'TerraformApproval',
                        message: "Review the plan above. Proceed with Terraform ${actionText} on Stage-5 (SQS + Lambda + ElastiCache Redis + Amazon RDS + ALB + ASG)?",
                        ok: "Proceed with ${actionText}"
                    )
                }
            }
        }

        stage('Terraform Apply / Destroy') {
            when {
                expression { return params.ACTION == 'apply' || params.ACTION == 'destroy' }
            }
            steps {
                script {
                    if (params.ACTION == 'apply') {
                        echo "🚀 Applying Stage-5 infrastructure (SQS + Lambda + ASG + Redis + RDS) via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    } else if (params.ACTION == 'destroy') {
                        echo "💥 Destroying Stage-5 infrastructure via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    }
                }
            }
        }

        stage('Smoke Test & Decoupled Pipeline Verification') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_DIR}") {
                    echo "🩺 Verifying Stage-5 Storefront, SQS Queue, and Lambda Worker..."
                    sh '''
                        ALB_DNS=$(grep -o '"alb_dns_name": *"[^"]*"' terraform.tfstate | head -n1 | cut -d '"' -f4 || true)

                        if [ -z "$ALB_DNS" ]; then
                            echo "⚠️ Could not parse ALB DNS name from state, skipping health test."
                            exit 0
                        fi

                        HEALTH_URL="http://${ALB_DNS}/health"
                        echo "Target ALB Health Check: $HEALTH_URL"
                        echo "Waiting for ASG instances, RDS, Redis, and SQS connectivity..."

                        ATTEMPTS=0
                        MAX_ATTEMPTS=30
                        SUCCESS=0

                        until [ $ATTEMPTS -ge $MAX_ATTEMPTS ]; do
                            RES=$(curl -s "$HEALTH_URL" || true)
                            if echo "$RES" | grep -q '"status":"UP"'; then
                                echo "✅ Stage-5 is UP and healthy!"
                                echo "$RES"
                                SUCCESS=1
                                break
                            else
                                echo "⏳ Attempt $((ATTEMPTS+1))/$MAX_ATTEMPTS: Waiting for instance bootstrap & health check (15s)..."
                                sleep 15
                                ATTEMPTS=$((ATTEMPTS+1))
                            fi
                        done

                        if [ $SUCCESS -ne 1 ]; then
                            echo "❌ Health check timed out after 7.5 minutes."
                            exit 1
                        fi

                        echo "📬 1. Checking SQS Queue Statistics via API:"
                        curl -s "http://${ALB_DNS}/api/queue/stats" || true
                        echo ""

                        echo "🛒 2. Submitting Asynchronous Order (Non-blocking HTTP 202 Accepted):"
                        ORDER_RESP=$(curl -s -X POST "http://${ALB_DNS}/api/orders" \
                            -H "Content-Type: application/json" \
                            -d '{"customerName":"Jenkins Test","customerEmail":"jenkins@shopsphere.io","shippingAddress":"100 Cloud Blvd, Seattle WA","items":[{"productId":1,"quantity":1}]}')
                        echo "Order Placement Response: $ORDER_RESP"

                        ORDER_ID=$(echo "$ORDER_RESP" | grep -o '"orderId":[0-9]*' | cut -d: -f2 || true)
                        if [ -n "$ORDER_ID" ]; then
                            echo "✅ Order #${ORDER_ID} ingested! Polling for Lambda worker fulfillment..."
                            sleep 3
                            curl -s "http://${ALB_DNS}/api/orders/${ORDER_ID}/status" || true
                            echo ""
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            dir("${env.TF_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo "🎉 ShopSphere Stage-5 ${params.ACTION.toUpperCase()} completed successfully!"
        }
        failure {
            echo "❌ ShopSphere Stage-5 Pipeline failed. Check console output."
        }
    }
}
