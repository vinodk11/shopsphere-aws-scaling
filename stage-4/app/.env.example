# ShopSphere Stage 4 - Application Environment Variables
PORT=8080
NODE_ENV=production

# Amazon RDS PostgreSQL Database Connection
DB_HOST=shopsphere-stage4-postgres.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=shopspheredb
DB_USER=shopsphere_user
DB_PASSWORD=YourSuperSecretStrongPassword123!
DB_SSL=true

# Amazon ElastiCache Redis In-Memory Cache Connection
REDIS_HOST=shopsphere-stage4-redis.xxxxxx.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_TTL_SECONDS=60

# Stage Configuration
STAGE_NAME=stage-4
ARCHITECTURE_TIER=ALB-ASG-ELASTICACHE-RDS
