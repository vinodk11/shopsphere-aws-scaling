pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to perform on Stage-4 (ALB + ASG + ElastiCache Redis + Amazon RDS)'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual confirmation before apply or destroy'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_DIR           = 'stage-4/terraform'
        TF_IMAGE         = 'hashicorp/terraform:latest'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo "🚀 Checking out ShopSphere Stage 4 repository..."
                git branch: 'main', url: 'https://github.com/vinodk11/shopsphere-aws-scaling.git'
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                echo "🔧 Running terraform init & validate via Docker container for Stage-4 (ALB + ASG + Redis + RDS)..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} version

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} init -input=false

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} validate
                """
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        echo "⚠️ Generating DESTROY plan for Stage-4..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -destroy -out=tfplan -input=false
                        """
                    } else {
                        echo "📋 Generating execution plan for Stage-4..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -out=tfplan -input=false
                        """
                    }
                }
            }
        }

        stage('Approval Gate') {
            when {
                expression { 
                    return (params.ACTION == 'apply' || params.ACTION == 'destroy') && !params.AUTO_APPROVE 
                }
            }
            steps {
                script {
                    def actionText = params.ACTION == 'destroy' ? 'DESTROY' : 'APPLY'
                    input(
                        id: 'TerraformApproval',
                        message: "Review the plan above. Proceed with Terraform ${actionText} on Stage-4 (ALB + ASG + ElastiCache Redis + Amazon RDS)?",
                        ok: "Proceed with ${actionText}"
                    )
                }
            }
        }

        stage('Terraform Apply / Destroy') {
            when {
                expression { return params.ACTION == 'apply' || params.ACTION == 'destroy' }
            }
            steps {
                script {
                    if (params.ACTION == 'apply') {
                        echo "🚀 Applying Stage-4 infrastructure (ALB + ASG + Redis + RDS) via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    } else if (params.ACTION == 'destroy') {
                        echo "💥 Destroying Stage-4 infrastructure via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    }
                }
            }
        }

        stage('Connect ASG Fleet to ElastiCache Redis') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                echo "🔗 Reconfiguring Stage 3 ASG EC2 instances to connect to ElastiCache Redis via AWS SSM..."
                sh """
                    chmod +x ${env.TF_DIR}/scripts/connect_asg_to_redis.sh
                    ${env.TF_DIR}/scripts/connect_asg_to_redis.sh || echo "⚠️ SSM connect script completed with warnings."
                """
            }
        }

        stage('Smoke Test & Cache Verification') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_DIR}") {
                    echo "🩺 Verifying Stage-4 Storefront, RDS, and ElastiCache Redis..."
                    sh '''
                        ALB_DNS=$(grep -o '"alb_dns_name": *"[^"]*"' terraform.tfstate | head -n1 | cut -d '"' -f4 || true)
                        if [ -z "$ALB_DNS" ]; then
                            ALB_DNS=$(aws elbv2 describe-load-balancers --query "LoadBalancers[?contains(LoadBalancerName, 'shopsphere')].DNSName | [0]" --output text 2>/dev/null || true)
                        fi

                        if [ -z "$ALB_DNS" ] || [ "$ALB_DNS" = "None" ]; then
                            echo "⚠️ Could not parse ALB DNS name, skipping health test."
                            exit 0
                        fi

                        HEALTH_URL="http://${ALB_DNS}/health"
                        echo "Target ALB Health Check: $HEALTH_URL"
                        echo "Waiting for ASG instances, RDS, and ElastiCache Redis to be ready..."

                        ATTEMPTS=0
                        MAX_ATTEMPTS=30
                        SUCCESS=0

                        until [ $ATTEMPTS -ge $MAX_ATTEMPTS ]; do
                            RES=$(curl -s "$HEALTH_URL" || true)
                            if echo "$RES" | grep -q '"status":"UP"'; then
                                echo "✅ Stage-4 is UP and healthy!"
                                echo "$RES"
                                SUCCESS=1
                                break
                            else
                                echo "⏳ Attempt $((ATTEMPTS+1))/$MAX_ATTEMPTS: Waiting for instance bootstrap & health check (15s)..."
                                sleep 15
                                ATTEMPTS=$((ATTEMPTS+1))
                            fi
                        done

                        if [ $SUCCESS -ne 1 ]; then
                            echo "❌ Health check timed out after 7.5 minutes."
                            exit 1
                        fi

                        echo "⚡ Testing Cache-Aside performance (Cold vs Warm)..."
                        echo "1. First Query (Cold Cache -> RDS Database Miss):"
                        curl -i -s "http://${ALB_DNS}/api/products" | grep -E 'X-Cache|latencyMs|source' || true

                        echo "2. Second Query (Warm Cache -> ElastiCache Redis Hit):"
                        curl -i -s "http://${ALB_DNS}/api/products" | grep -E 'X-Cache|latencyMs|source' || true

                        echo "3. Cache Statistics:"
                        curl -s "http://${ALB_DNS}/api/cache/stats" || true
                        echo ""
                    '''
                }
            }
        }
    }

    post {
        always {
            dir("${env.TF_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo "🎉 ShopSphere Stage-4 ${params.ACTION.toUpperCase()} completed successfully!"
        }
        failure {
            echo "❌ ShopSphere Stage-4 Pipeline failed. Check console output."
        }
    }
}
