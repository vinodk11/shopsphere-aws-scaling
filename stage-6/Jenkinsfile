pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to perform on Stage-6 (CloudFront CDN + AWS WAFv2 + ALB + ASG + Redis + SQS + Lambda + RDS)'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual confirmation before apply or destroy'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_DIR           = 'stage-6/terraform'
        TF_IMAGE         = 'hashicorp/terraform:latest'
    }

    options {
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo "🚀 Checking out ShopSphere Stage 6 repository..."
                git branch: 'main', url: 'https://github.com/vinodk11/shopsphere-aws-scaling.git'
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                echo "🔧 Running terraform init & validate via Docker container for Stage-6..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} version

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} init -input=false

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} validate
                """
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        echo "⚠️ Generating DESTROY plan for Stage-6..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -destroy -out=tfplan -input=false
                        """
                    } else {
                        echo "📋 Generating execution plan for Stage-6 (CloudFront + WAF + Decoupled Stack)..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -out=tfplan -input=false
                        """
                    }
                }
            }
        }

        stage('Approval Gate') {
            when {
                expression { 
                    return (params.ACTION == 'apply' || params.ACTION == 'destroy') && !params.AUTO_APPROVE 
                }
            }
            steps {
                script {
                    def actionText = params.ACTION == 'destroy' ? 'DESTROY' : 'APPLY'
                    input(
                        id: 'TerraformApproval',
                        message: "Review the plan above. Proceed with Terraform ${actionText} on Stage-6 (CloudFront + WAF + ALB Lockdown + SQS + Lambda + RDS)?",
                        ok: "Proceed with ${actionText}"
                    )
                }
            }
        }

        stage('Terraform Apply / Destroy') {
            when {
                expression { return params.ACTION == 'apply' || params.ACTION == 'destroy' }
            }
            steps {
                script {
                    if (params.ACTION == 'apply') {
                        echo "🚀 Applying Stage-6 infrastructure via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    } else if (params.ACTION == 'destroy') {
                        echo "💥 Destroying Stage-6 infrastructure via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    }
                }
            }
        }

        stage('Perimeter Security & Edge Caching Verification') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_DIR}") {
                    echo "🩺 Verifying Stage-6 CloudFront CDN, AWS WAFv2, and Origin Header Lockdown..."
                    sh '''
                        CF_DOMAIN=$(grep -o '"cloudfront_domain_name": *"[^"]*"' terraform.tfstate | head -n1 | cut -d '"' -f4 || true)
                        ALB_DNS=$(grep -o '"alb_dns_name": *"[^"]*"' terraform.tfstate | head -n1 | cut -d '"' -f4 || true)

                        if [ -z "$CF_DOMAIN" ]; then
                            echo "⚠️ Could not parse CloudFront domain name from state, skipping edge verification."
                            exit 0
                        fi

                        echo "🌐 CloudFront Distribution: https://${CF_DOMAIN}"
                        echo "⚖️ Direct ALB Origin: http://${ALB_DNS}"
                        echo "Waiting for CloudFront and EC2 instances to become ready..."

                        ATTEMPTS=0
                        MAX_ATTEMPTS=30
                        SUCCESS=0

                        until [ $ATTEMPTS -ge $MAX_ATTEMPTS ]; do
                            RES=$(curl -s "https://${CF_DOMAIN}/health" || true)
                            if echo "$RES" | grep -q '"status":"UP"'; then
                                echo "✅ Stage-6 Edge & Origin is UP and healthy!"
                                echo "$RES"
                                SUCCESS=1
                                break
                            else
                                echo "⏳ Attempt $((ATTEMPTS+1))/$MAX_ATTEMPTS: Waiting for distribution & origin (15s)..."
                                sleep 15
                                ATTEMPTS=$((ATTEMPTS+1))
                            fi
                        done

                        if [ $SUCCESS -ne 1 ]; then
                            echo "❌ Health check through CloudFront timed out."
                            exit 1
                        fi

                        echo "🔒 1. Verifying ALB Origin Lockdown (Direct access MUST return HTTP 403 Forbidden):"
                        DIRECT_CODE=$(curl -s -o /dev/null -w "%{http_code}" "http://${ALB_DNS}/health" || true)
                        echo "Direct ALB HTTP Status: $DIRECT_CODE"
                        if [ "$DIRECT_CODE" = "403" ]; then
                            echo "✅ Direct origin access blocked as expected (HTTP 403)!"
                        else
                            echo "⚠️ Warning: Expected HTTP 403 on direct ALB access, got: $DIRECT_CODE"
                        fi

                        echo "🛡️ 2. Verifying AWS WAF Protection via CloudFront (SQL Injection test):"
                        WAF_CODE=$(curl -s -o /dev/null -w "%{http_code}" "https://${CF_DOMAIN}/api/products?id=1%20OR%201=1" || true)
                        echo "WAF SQLi Probe Status: $WAF_CODE"
                        if [ "$WAF_CODE" = "403" ]; then
                            echo "✅ AWS WAF blocked malicious SQLi payload at the edge (HTTP 403)!"
                        else
                            echo "ℹ️ WAF Response Code: $WAF_CODE"
                        fi

                        echo "⚡ 3. Verifying CloudFront Edge Caching on Static Assets:"
                        echo "First request (Cache MISS):"
                        curl -s -I "https://${CF_DOMAIN}/styles.css" | grep -iE "(x-cache|via|age)" || true
                        sleep 1
                        echo "Second request (Cache HIT):"
                        curl -s -I "https://${CF_DOMAIN}/styles.css" | grep -iE "(x-cache|via|age)" || true

                        echo "🩺 4. Edge Diagnostics Endpoint:"
                        curl -s "https://${CF_DOMAIN}/api/edge-info" || true
                        echo ""
                    '''
                }
            }
        }
    }

    post {
        always {
            dir("${env.TF_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo "🎉 ShopSphere Stage-6 ${params.ACTION.toUpperCase()} completed successfully!"
        }
        failure {
            echo "❌ ShopSphere Stage-6 Pipeline failed. Check console output."
        }
    }
}
