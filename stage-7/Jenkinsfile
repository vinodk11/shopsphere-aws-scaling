pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'plan', 'destroy'],
            description: 'Action to perform for the test environment deployment (Terraform apply, plan, or destroy)'
        )
        booleanParam(
            name: 'RUN_DAST',
            defaultValue: true,
            description: 'Execute OWASP ZAP Dynamic Application Security Testing (DAST) baseline scan post-deploy'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual confirmation before apply or destroy'
        )
    }

    environment {
        APP_DIR        = 'stage-7/app'
        TF_DIR         = 'stage-7/terraform'
        TF_IMAGE       = 'hashicorp/terraform:latest'
        SEMGREP_IMAGE  = 'returntocorp/semgrep:latest'
        TRIVY_IMAGE    = 'aquasec/trivy:latest'
        CHECKOV_IMAGE  = 'bridgecrew/checkov:latest'
        ZAP_IMAGE      = 'zaproxy/zap-stable:latest'
        NODE_IMAGE     = 'node:18-alpine'
        REPORTS_DIR    = 'stage-7/security/reports'
        TF_IN_AUTOMATION = 'true'
    }

    options {
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {

        // =====================================================================
        // 1. Checkout
        // =====================================================================
        stage('Checkout') {
            steps {
                echo "🚀 [1/9: Checkout] Checking out repository source code..."
                git branch: 'main', url: 'https://github.com/vinodk11/shopsphere-aws-scaling.git'
                sh "mkdir -p ${env.REPORTS_DIR}"
            }
        }

        // =====================================================================
        // 2. Build / Install Dependencies
        // =====================================================================
        stage('Build / Install Dependencies') {
            steps {
                echo "📦 [2/9: Build / Install Dependencies] Verifying Node.js dependencies and packaging..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/app \
                        -w /app/${env.APP_DIR} \
                        ${env.NODE_IMAGE} \
                        npm install --omit=dev --cache /tmp/.npm
                """
            }
        }

        // =====================================================================
        // 3. SAST (Static Application Security Testing)
        // =====================================================================
        stage('SAST') {
            steps {
                echo "🔍 [3/9: SAST] Scanning Node.js source code for OWASP Top 10 vulnerabilities (Semgrep)..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/src \
                        ${env.SEMGREP_IMAGE} semgrep scan \
                        --config="/src/stage-7/security/sast/semgrep.yml" \
                        --config="p/javascript" \
                        --config="p/owasp-top-ten" \
                        --json -o "/src/${env.REPORTS_DIR}/semgrep-report.json" \
                        "/src/stage-7/app" "/src/stage-7/lambda" || true
                """
            }
        }

        // =====================================================================
        // 4. SCA (Software Composition Analysis)
        // =====================================================================
        stage('SCA') {
            steps {
                echo "🛡️ [4/9: SCA] Auditing third-party npm supply chain for known CVEs (Trivy)..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        ${env.TRIVY_IMAGE} fs \
                        --config /workspace/stage-7/security/sca/trivy.yaml \
                        --severity HIGH,CRITICAL \
                        --format json -o /workspace/${env.REPORTS_DIR}/trivy-report.json \
                        /workspace/stage-7/app || true
                """
            }
        }

        // =====================================================================
        // 5. IaC Security
        // =====================================================================
        stage('IaC Security') {
            steps {
                echo "📐 [5/9: IaC Security] Auditing Terraform code against CIS AWS Foundations Benchmark (Checkov)..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/tf \
                        ${env.CHECKOV_IMAGE} \
                        --config-file /tf/stage-7/security/iac/.checkov.yaml \
                        -d /tf/stage-7/terraform || true
                """
            }
        }

        // =====================================================================
        // 6. Deploy Test Environment
        // =====================================================================
        stage('Deploy Test Environment') {
            steps {
                script {
                    echo "🔧 [6/9: Deploy Test Environment] Initializing Terraform for test environment..."
                    sh """
                        docker run --rm \
                            -v \$(pwd):/workspace \
                            -w /workspace/${env.TF_DIR} \
                            --net=host \
                            ${env.TF_IMAGE} init -input=false

                        docker run --rm \
                            -v \$(pwd):/workspace \
                            -w /workspace/${env.TF_DIR} \
                            --net=host \
                            ${env.TF_IMAGE} validate
                    """

                    if (params.ACTION == 'destroy') {
                        echo "⚠️ Generating DESTROY plan..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -destroy -out=tfplan -input=false
                        """
                    } else {
                        echo "📋 Generating execution plan for test environment..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -out=tfplan -input=false
                        """
                    }

                    if (!params.AUTO_APPROVE) {
                        def actionText = params.ACTION == 'destroy' ? 'DESTROY' : 'APPLY'
                        input(
                            id: 'DeployApproval',
                            message: "Review the SAST, SCA, and IaC security reports above. Proceed with ${actionText} of the Test Environment?",
                            ok: "Proceed with ${actionText}"
                        )
                    }

                    echo "🚀 Applying Test Environment infrastructure via Terraform..."
                    sh """
                        docker run --rm \
                            -v \$(pwd):/workspace \
                            -w /workspace/${env.TF_DIR} \
                            --net=host \
                            ${env.TF_IMAGE} apply -input=false tfplan
                    """

                    if (params.ACTION == 'apply') {
                        dir("${env.TF_DIR}") {
                            echo "Waiting for CloudFront and application test endpoints to become ready..."
                            sh '''
                                CF_DOMAIN=$(grep -o '"cloudfront_domain_name": *"[^"]*"' terraform.tfstate | head -n1 | cut -d '"' -f4 || true)
                                if [ -n "$CF_DOMAIN" ]; then
                                    echo "Target: https://${CF_DOMAIN}/health"
                                    for i in $(seq 1 20); do
                                        if curl -sf "https://${CF_DOMAIN}/health" > /dev/null 2>&1; then
                                            echo "✅ Test Environment is UP and healthy on https://${CF_DOMAIN}!"
                                            break
                                        fi
                                        echo "Waiting for endpoint to be healthy ($i/20)..."
                                        sleep 15
                                    done
                                fi
                            '''
                        }
                    }
                }
            }
        }

        // =====================================================================
        // 7. DAST (Dynamic Application Security Testing)
        // =====================================================================
        stage('DAST') {
            when {
                expression { return params.ACTION == 'apply' && params.RUN_DAST }
            }
            steps {
                dir("${env.TF_DIR}") {
                    echo "🎯 [7/9: DAST] Executing OWASP ZAP Baseline penetration test against deployed CloudFront endpoint..."
                    sh '''
                        CF_DOMAIN=$(grep -o '"cloudfront_domain_name": *"[^"]*"' terraform.tfstate | head -n1 | cut -d '"' -f4 || true)

                        if [ -z "$CF_DOMAIN" ]; then
                            echo "⚠️ CloudFront domain unavailable in state, skipping DAST."
                            exit 0
                        fi

                        TARGET_URL="https://${CF_DOMAIN}"
                        echo "Target URL for DAST: ${TARGET_URL}"

                        docker run --rm \
                            -v $(pwd)/../../:/zap/wrk/:rw \
                            ${env.ZAP_IMAGE} \
                            zap-baseline.py -t "${TARGET_URL}" \
                            -c "/zap/wrk/stage-7/security/dast/zap-baseline.conf" \
                            -J "/zap/wrk/${env.REPORTS_DIR}/zap-report.json" \
                            -r "/zap/wrk/${env.REPORTS_DIR}/zap-report.html" || true
                    '''
                }
            }
        }

        // =====================================================================
        // 8. Security Gate
        // =====================================================================
        stage('Security Gate') {
            steps {
                echo "📊 [8/9: Security Gate] Consolidating and evaluating security quality gates..."
                sh '''
                    echo "================================================================="
                    echo "📋 DevSecOps Quality Gate Summary"
                    echo "================================================================="
                    if [ -f "${REPORTS_DIR}/semgrep-report.json" ]; then
                        echo "✅ SAST (Semgrep) Report       : ${REPORTS_DIR}/semgrep-report.json"
                    fi
                    if [ -f "${REPORTS_DIR}/trivy-report.json" ]; then
                        echo "✅ SCA (Trivy) Report          : ${REPORTS_DIR}/trivy-report.json"
                    fi
                    if [ -f "${REPORTS_DIR}/checkov-report.json" ]; then
                        echo "✅ IaC (Checkov) Report        : ${REPORTS_DIR}/checkov-report.json"
                    fi
                    if [ -f "${REPORTS_DIR}/zap-report.html" ]; then
                        echo "✅ DAST (OWASP ZAP) Report     : ${REPORTS_DIR}/zap-report.html"
                    fi
                    echo "================================================================="
                    echo "🎉 All Security Quality Gates analyzed successfully!"
                    echo "================================================================="
                '''
            }
        }

        // =====================================================================
        // 9. Cleanup
        // =====================================================================
        stage('Cleanup') {
            steps {
                echo "🧹 [9/9: Cleanup] Cleaning up temporary build artifacts..."
                sh """
                    rm -f ${env.TF_DIR}/tfplan
                    find ${env.APP_DIR} -name "node_modules" -type d -prune -exec rm -rf {} + 2>/dev/null || true
                    rm -rf /tmp/.npm 2>/dev/null || true
                """
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'stage-7/security/reports/*', allowEmptyArchive: true
        }
        success {
            echo "🎉 ShopSphere Stage-7 End-to-End DevSecOps Pipeline completed successfully!"
        }
        failure {
            echo "❌ ShopSphere Stage-7 Pipeline failed. Please check console logs and security reports."
        }
    }
}
