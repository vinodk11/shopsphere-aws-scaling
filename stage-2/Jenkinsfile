pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to perform on Stage-2 (EC2 App Tier + Decoupled Amazon RDS PostgreSQL)'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual confirmation before apply or destroy'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_DIR           = 'stage-2/terraform'
        TF_IMAGE         = 'hashicorp/terraform:latest'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo "🚀 Checking out ShopSphere Stage 2 repository..."
                git branch: 'main', url: 'https://github.com/vinodk11/shopsphere-aws-scaling.git'
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                echo "🔧 Running terraform init & validate via Docker container for Stage-2 (EC2 + RDS)..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} version

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} init -input=false

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} validate
                """
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        echo "⚠️ Generating DESTROY plan for Stage-2 (including RDS)..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -destroy -out=tfplan -input=false
                        """
                    } else {
                        echo "📋 Generating execution plan for Stage-2..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -out=tfplan -input=false
                        """
                    }
                }
            }
        }

        stage('Approval Gate') {
            when {
                expression { 
                    return (params.ACTION == 'apply' || params.ACTION == 'destroy') && !params.AUTO_APPROVE 
                }
            }
            steps {
                script {
                    def actionText = params.ACTION == 'destroy' ? 'DESTROY' : 'APPLY'
                    input(
                        id: 'TerraformApproval',
                        message: "Review the plan above. Proceed with Terraform ${actionText} on Stage-2 (EC2 + Amazon RDS)?",
                        ok: "Proceed with ${actionText}"
                    )
                }
            }
        }

        stage('Terraform Apply / Destroy') {
            when {
                expression { return params.ACTION == 'apply' || params.ACTION == 'destroy' }
            }
            steps {
                script {
                    if (params.ACTION == 'apply') {
                        echo "🚀 Applying Stage-2 infrastructure (EC2 + Amazon RDS) via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    } else if (params.ACTION == 'destroy') {
                        echo "💥 Destroying Stage-2 infrastructure via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    }
                }
            }
        }

        stage('Connect EC2 to Amazon RDS') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_DIR}") {
                    echo "🔗 Reconfiguring Stage 1 EC2 Monolith to connect to Stage 2 Amazon RDS..."
                    sh './scripts/connect_ec2_to_rds.sh'
                }
            }
        }

        stage('Smoke Test & RDS Verification') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_DIR}") {
                    echo "🩺 Verifying Stage-2 Storefront & Amazon RDS Connectivity..."
                    sh '''
                        EC2_IP=$(terraform output -raw stage1_ec2_public_ip 2>/dev/null || true)

                        if [ -z "$EC2_IP" ] || [ "$EC2_IP" = "pending" ]; then
                            EC2_IP=$(aws ec2 describe-instances --region "${AWS_DEFAULT_REGION:-us-east-1}" \
                                --filters "Name=tag:Name,Values=shopsphere-*-ec2" "Name=instance-state-name,Values=running" \
                                --query "Reservations[0].Instances[0].PublicIpAddress" --output text || true)
                        fi

                        if [ -z "$EC2_IP" ] || [ "$EC2_IP" = "None" ]; then
                            echo "⚠️ Could not parse EC2 public IP, skipping external health test."
                            exit 0
                        fi

                        HEALTH_URL="http://${EC2_IP}/health"
                        echo "Target Health Check: $HEALTH_URL"
                        echo "Verifying application is live and connected to RDS..."

                        ATTEMPTS=0
                        MAX_ATTEMPTS=15
                        SUCCESS=0

                        until [ $ATTEMPTS -ge $MAX_ATTEMPTS ]; do
                            RES=$(curl -s --connect-timeout 5 "$HEALTH_URL" || true)
                            if echo "$RES" | grep -q '"status":"UP"'; then
                                echo "✅ Stage-2 is UP and connected to Amazon RDS!"
                                echo "$RES"
                                SUCCESS=1
                                break
                            else
                                echo "⏳ Attempt $((ATTEMPTS+1))/$MAX_ATTEMPTS: Waiting for RDS response (10s)..."
                                sleep 10
                                ATTEMPTS=$((ATTEMPTS+1))
                            fi
                        done

                        if [ $SUCCESS -ne 1 ]; then
                            echo "⚠️ Health check reached timeout; check security group or logs."
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            dir("${env.TF_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo "🎉 ShopSphere Stage-2 ${params.ACTION.toUpperCase()} completed successfully!"
        }
        failure {
            echo "❌ ShopSphere Stage-2 Pipeline failed. Check console output."
        }
    }
}
