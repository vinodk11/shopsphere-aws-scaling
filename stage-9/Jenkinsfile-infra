// ShopSphere Stage 9 - Infrastructure Pipeline v2
// Jenkins plugins handle AWS context, Terraform tooling, reports and approvals.
// No project shell scripts are called from this pipeline.

pipeline {
  agent any

  parameters {
    choice(name: 'ACTION', choices: ['plan', 'apply'], description: 'Never destroy Stage 8 from this job.')
    booleanParam(name: 'AUTO_APPROVE', defaultValue: false, description: 'Skip the apply approval gate.')
    booleanParam(name: 'ENABLE_PRODUCT_PATH', defaultValue: false, description: 'Enable /api/products* ALB rule.')
    booleanParam(name: 'ENABLE_ORDER_PATH', defaultValue: false, description: 'Enable /api/orders* ALB rule.')
    booleanParam(name: 'ENABLE_USER_PATH', defaultValue: false, description: 'Enable /api/users* ALB rule.')
    string(name: 'BLUE_WEIGHT', defaultValue: '100', description: 'Stage 8 target-group weight.')
    string(name: 'GREEN_WEIGHT', defaultValue: '0', description: 'Stage 9 target-group weight.')
  }

  tools {
    terraform 'terraform-1.9'
  }

  environment {
    TF_DIR = 'stage-9/terraform'
    AWS_REGION = 'us-east-1'
    AWS_CREDENTIALS = 'aws-jenkins'
  }

  options {
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    ansiColor('xterm')
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Terraform Format') {
      steps {
        dir(env.TF_DIR) {
          sh 'terraform fmt -check -recursive'
        }
      }
    }

    stage('Terraform Init') {
      steps {
        dir(env.TF_DIR) {
          withAWS(credentials: env.AWS_CREDENTIALS, region: env.AWS_REGION) {
            sh 'terraform init -input=false'
          }
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        dir(env.TF_DIR) { sh 'terraform validate' }
      }
    }

    stage('Checkov IaC Scan') {
      steps {
        script {
          docker.image('bridgecrew/checkov:3.2.451').inside('-v "${WORKSPACE}:/workspace"') {
            sh 'checkov -d /workspace/stage-9/terraform --config-file /workspace/stage-9/security/iac/.checkov.yaml --output sarif --output-file-path /workspace/stage-9/security/reports/checkov.sarif'
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'stage-9/security/reports/checkov.sarif', allowEmptyArchive: true }
      }
    }

    stage('Terraform Plan') {
      steps {
        dir(env.TF_DIR) {
          withAWS(credentials: env.AWS_CREDENTIALS, region: env.AWS_REGION) {
            sh 'terraform plan -input=false -var=enable_product_path_routing=${ENABLE_PRODUCT_PATH} -var=enable_order_path_routing=${ENABLE_ORDER_PATH} -var=enable_user_path_routing=${ENABLE_USER_PATH} -var=blue_weight=${BLUE_WEIGHT} -var=green_weight=${GREEN_WEIGHT} -out=stage9.tfplan'
            sh 'terraform show -no-color stage9.tfplan > stage9-plan.txt'
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'stage-9/terraform/stage9.tfplan,stage-9/terraform/stage9-plan.txt', allowEmptyArchive: true }
      }
    }

    stage('Approval') {
      when { expression { params.ACTION == 'apply' && !params.AUTO_APPROVE } }
      steps {
        input message: 'Review the Stage 9 Terraform plan. Stage 8 must remain untouched. Apply?', ok: 'Apply Stage 9'
      }
    }

    stage('Terraform Apply') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        dir(env.TF_DIR) {
          withAWS(credentials: env.AWS_CREDENTIALS, region: env.AWS_REGION) {
            sh 'terraform apply -input=false stage9.tfplan'
          }
        }
      }
    }

    stage('Export Infrastructure Outputs') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        dir(env.TF_DIR) {
          withAWS(credentials: env.AWS_CREDENTIALS, region: env.AWS_REGION) {
            sh 'terraform output -json > stage9-outputs.json'
          }
        }
      }
      post { always { archiveArtifacts artifacts: 'stage-9/terraform/stage9-outputs.json', allowEmptyArchive: true } }
    }

    stage('Install AWS Load Balancer Controller') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        withKubeConfig([credentialsId: 'shopsphere-stage9-kubeconfig', namespace: 'kube-system']) {
          script {
            def outputs = readJSON file: 'stage-9/terraform/stage9-outputs.json'
            env.LBC_ROLE_ARN = outputs.aws_load_balancer_controller_role_arn.value
            env.EKS_CLUSTER_NAME = outputs.eks_cluster_name.value
          }
          sh 'helm repo add eks https://aws.github.io/eks-charts && helm repo update'
          sh 'helm upgrade --install aws-load-balancer-controller eks/aws-load-balancer-controller --namespace kube-system --create-namespace --set clusterName=${EKS_CLUSTER_NAME} --set serviceAccount.create=true --set serviceAccount.name=aws-load-balancer-controller --set serviceAccount.annotations.eks\\.amazonaws\\.com/role-arn=${LBC_ROLE_ARN} --wait'
        }
      }
    }

    stage('Infrastructure Outputs') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        echo 'Infrastructure outputs were exported and archived before the Kubernetes add-on installation.'
      }
    }
  }

  post {
    success { echo 'Stage 9 infrastructure pipeline completed. Stage 8 was not intentionally destroyed or replaced.' }
    failure { echo 'Stage 9 infrastructure pipeline failed. Do not proceed with traffic migration until the plan/apply issue is fixed.' }
  }
}
