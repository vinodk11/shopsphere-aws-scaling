// =============================================================================
// ShopSphere Stage 9 - Dedicated Microservices Application CI/CD Pipeline
// =============================================================================
// Responsibility: Microservices build, unit testing, multi-service Docker packaging,
// image vulnerability scanning, ECR push with immutable tags, EKS deployment,
// in-cluster health validation, progressive traffic migration, and DAST security gating.
//
// This pipeline does NOT run Terraform apply or provision AWS infrastructure.
//
// Pipeline Flow:
//   Checkout & Versioning
//   ↓
//   Application Build & Unit Tests (Product, Order, User Services)
//   ↓
//   Parallel Application Security (Gitleaks Secrets, Semgrep SAST, Trivy SCA)
//   ↓
//   Microservices Docker Multi-Stage Builds (Product, Order, User)
//   ↓
//   Container Image Security Scanning (Trivy Image Scan)
//   ↓
//   Amazon ECR Immutable Tag Publishing
//   ↓
//   Deploy Workloads & Microservices to Amazon EKS (deploy.sh)
//   ↓
//   Multi-Tier Health & Data Layer Verification (health-check.sh)
//   ↓
//   Progressive Traffic Migration Gate (migrate-traffic.sh)
//   ↓
//   Dynamic Application Security Testing (OWASP ZAP DAST)
//   ↓
//   Final Security Quality Gate
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['stage9', 'dev', 'test', 'prod'],
            description: 'Target AWS environment hosting the Stage 9 EKS infrastructure'
        )
        string(
            name: 'OVERRIDE_IMAGE_TAG',
            defaultValue: '',
            description: 'Optional manual immutable image tag override (Default: v9.${BUILD_NUMBER}-${GIT_COMMIT})'
        )
        choice(
            name: 'MIGRATION_WEIGHT',
            choices: ['100-0 (Test Green 0%)', '90-10 (Canary 10%)', '75-25 (Migration 25%)', '50-50 (Balanced 50%)', '25-75 (Majority 75%)', '0-100 (Full EKS 100%)'],
            description: 'ALB Blue/Green traffic weight distribution [Stage 8 Blue - Stage 9 Green]'
        )
        booleanParam(
            name: 'ENABLE_PATH_ROUTING',
            defaultValue: false,
            description: 'Activate path-based routing rules (/api/products*, /api/orders*) directly to EKS microservices'
        )
        booleanParam(
            name: 'RUN_DAST',
            defaultValue: true,
            description: 'Execute OWASP ZAP Dynamic Application Security Testing (DAST) baseline scan post-deployment'
        )
        booleanParam(
            name: 'STRICT_SECURITY_GATES',
            defaultValue: false,
            description: 'Fail pipeline on any CRITICAL vulnerability detected across security scanners'
        )
    }

    environment {
        SERVICES_DIR       = 'stage-9/services'
        REPORTS_DIR        = 'stage-9/security/reports'
        PROJECT_NAME       = 'shopsphere'
        AWS_DEFAULT_REGION = 'us-east-1'
        NODE_IMAGE         = 'node:18-alpine'
        SEMGREP_IMAGE      = 'returntocorp/semgrep:latest'
        TRIVY_IMAGE        = 'aquasec/trivy:latest'
        GITLEAKS_IMAGE     = 'zricethezav/gitleaks:latest'
        ZAP_IMAGE          = 'zaproxy/zap-stable:latest'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        ansiColor('xterm')
    }

    stages {

        // =====================================================================
        // 1. Source Checkout & Versioning
        // =====================================================================
        stage('Checkout & Versioning') {
            steps {
                echo "🚀 [1/11: Checkout] Checking out application source code..."
                checkout scm
                script {
                    def gitCommitShort = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.GIT_COMMIT_SHORT = gitCommitShort

                    if (params.OVERRIDE_IMAGE_TAG && params.OVERRIDE_IMAGE_TAG.trim() != '') {
                        env.RELEASE_TAG = params.OVERRIDE_IMAGE_TAG.trim()
                    } else {
                        env.RELEASE_TAG = "v9.${env.BUILD_NUMBER}-${gitCommitShort}"
                    }
                    echo "Immutable Release Tag : ${env.RELEASE_TAG}"

                    sh "mkdir -p ${env.REPORTS_DIR} build-dist"
                }
            }
        }

        // =====================================================================
        // 2. Unit Testing Microservices
        // =====================================================================
        stage('Unit Tests') {
            steps {
                echo "🧪 [2/11: Unit Tests] Running automated tests across microservices..."
                sh """
                    docker run --rm -v \$(pwd):/app -w /app/${env.SERVICES_DIR}/product ${env.NODE_IMAGE} node --test
                    docker run --rm -v \$(pwd):/app -w /app/${env.SERVICES_DIR}/order ${env.NODE_IMAGE} node --test
                    docker run --rm -v \$(pwd):/app -w /app/${env.SERVICES_DIR}/user ${env.NODE_IMAGE} node --test
                """
            }
        }

        // =====================================================================
        // 3. Security Scans (SAST, Secrets, SCA)
        // =====================================================================
        stage('Application Security') {
            parallel {
                stage('Secrets Scan (Gitleaks)') {
                    steps {
                        echo "🔑 [3a: Gitleaks] Scanning repository for leaked secrets..."
                        sh """
                            docker run --rm -v \$(pwd):/repo ${env.GITLEAKS_IMAGE} \
                                detect --source=/repo -v --report-format=json --report-path=/repo/${env.REPORTS_DIR}/gitleaks-report.json || true
                        """
                    }
                }
                stage('SAST (Semgrep)') {
                    steps {
                        echo "🔍 [3b: Semgrep] Performing static security analysis..."
                        sh """
                            docker run --rm -v \$(pwd):/src ${env.SEMGREP_IMAGE} \
                                semgrep scan --config=/src/stage-9/security/sast/.semgrep.yaml --json -o /src/${env.REPORTS_DIR}/semgrep-report.json /src/${env.SERVICES_DIR} || true
                        """
                    }
                }
                stage('SCA (Trivy Filesystem)') {
                    steps {
                        echo "📦 [3c: Trivy SCA] Scanning dependency supply chain..."
                        sh """
                            docker run --rm -v \$(pwd):/workspace ${env.TRIVY_IMAGE} \
                                fs --severity HIGH,CRITICAL --format json -o /workspace/${env.REPORTS_DIR}/trivy-fs-report.json /workspace/${env.SERVICES_DIR} || true
                        """
                    }
                }
            }
        }

        // =====================================================================
        // 4. Docker Multi-Stage Image Builds
        // =====================================================================
        stage('Docker Builds') {
            steps {
                echo "🐳 [4/11: Docker Builds] Building hardened microservice containers..."
                sh """
                    echo "Building Product Service image..."
                    docker build -t shopsphere-product:${env.RELEASE_TAG} -t shopsphere-product:latest ${env.SERVICES_DIR}/product

                    echo "Building Order Service image..."
                    docker build -t shopsphere-order:${env.RELEASE_TAG} -t shopsphere-order:latest ${env.SERVICES_DIR}/order

                    echo "Building User Service image..."
                    docker build -t shopsphere-user:${env.RELEASE_TAG} -t shopsphere-user:latest ${env.SERVICES_DIR}/user
                """
            }
        }

        // =====================================================================
        // 5. Container Vulnerability Scans (Trivy Image)
        // =====================================================================
        stage('Container Image Scans') {
            steps {
                echo "🛡️ [5/11: Trivy Image] Scanning container images for CVEs..."
                sh """
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v \$(pwd):/workspace ${env.TRIVY_IMAGE} \
                        image --severity HIGH,CRITICAL --format json -o /workspace/${env.REPORTS_DIR}/trivy-product-report.json shopsphere-product:${env.RELEASE_TAG} || true

                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v \$(pwd):/workspace ${env.TRIVY_IMAGE} \
                        image --severity HIGH,CRITICAL --format json -o /workspace/${env.REPORTS_DIR}/trivy-order-report.json shopsphere-order:${env.RELEASE_TAG} || true
                """
            }
        }

        // =====================================================================
        // 6. Push to Amazon ECR
        // =====================================================================
        stage('ECR Publish') {
            steps {
                echo "📦 [6/11: ECR Push] Authenticating and pushing immutable tags to Amazon ECR..."
                script {
                    def accountId = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
                    def ecrPrefix = "${accountId}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com"

                    sh """
                        aws ecr get-login-password --region "${env.AWS_DEFAULT_REGION}" | docker login --username AWS --password-stdin "${ecrPrefix}"

                        # Tag & Push Product Service
                        docker tag shopsphere-product:${env.RELEASE_TAG} "${ecrPrefix}/shopsphere-stage9-product:${env.RELEASE_TAG}"
                        docker tag shopsphere-product:latest "${ecrPrefix}/shopsphere-stage9-product:latest"
                        docker push "${ecrPrefix}/shopsphere-stage9-product:${env.RELEASE_TAG}"
                        docker push "${ecrPrefix}/shopsphere-stage9-product:latest"

                        # Tag & Push Order Service
                        docker tag shopsphere-order:${env.RELEASE_TAG} "${ecrPrefix}/shopsphere-stage9-order:${env.RELEASE_TAG}"
                        docker tag shopsphere-order:latest "${ecrPrefix}/shopsphere-stage9-order:latest"
                        docker push "${ecrPrefix}/shopsphere-stage9-order:${env.RELEASE_TAG}"
                        docker push "${ecrPrefix}/shopsphere-stage9-order:latest"

                        # Tag & Push User Service
                        docker tag shopsphere-user:${env.RELEASE_TAG} "${ecrPrefix}/shopsphere-stage9-user:${env.RELEASE_TAG}"
                        docker tag shopsphere-user:latest "${ecrPrefix}/shopsphere-stage9-user:latest"
                        docker push "${ecrPrefix}/shopsphere-stage9-user:${env.RELEASE_TAG}"
                        docker push "${ecrPrefix}/shopsphere-stage9-user:latest"
                    """
                }
            }
        }

        // =====================================================================
        // 7. Deploy to Amazon EKS
        // =====================================================================
        stage('Deploy to EKS') {
            steps {
                echo "☸️ [7/11: EKS Deploy] Applying manifests & waiting for rollout on Amazon EKS..."
                sh """
                    chmod +x stage-9/scripts/deploy.sh
                    ./stage-9/scripts/deploy.sh "shopsphere-stage9-eks" "${env.RELEASE_TAG}"
                """
            }
        }

        // =====================================================================
        // 8. Health Verification
        // =====================================================================
        stage('Health Verification') {
            steps {
                echo "🔍 [8/11: Health Probing] Validating pod health, services, and backend integrations..."
                sh """
                    chmod +x stage-9/scripts/health-check.sh
                    ./stage-9/scripts/health-check.sh
                """
            }
        }

        // =====================================================================
        // 9. Progressive Traffic Migration Gate
        // =====================================================================
        stage('Traffic Migration') {
            steps {
                echo "🔀 [9/11: Traffic Shift] Applying selected traffic distribution: ${params.MIGRATION_WEIGHT}..."
                script {
                    def weights = params.MIGRATION_WEIGHT.split(' ')[0].split('-')
                    def blue = weights[0]
                    def green = weights[1]

                    sh """
                        chmod +x stage-9/scripts/migrate-traffic.sh
                        ./stage-9/scripts/migrate-traffic.sh weight "${blue}" "${green}"

                        if [ "${params.ENABLE_PATH_ROUTING}" == "true" ]; then
                            ./stage-9/scripts/migrate-traffic.sh path-product enable
                            ./stage-9/scripts/migrate-traffic.sh path-order enable
                        fi
                        ./stage-9/scripts/migrate-traffic.sh status
                    """
                }
            }
        }

        // =====================================================================
        // 10. Dynamic Application Security Testing (DAST)
        // =====================================================================
        stage('DAST (OWASP ZAP)') {
            when {
                expression { return params.RUN_DAST }
            }
            steps {
                echo "🎯 [10/11: DAST] Running OWASP ZAP vulnerability scan against live edge..."
                script {
                    def cfDomain = sh(
                        script: """
                            aws cloudfront list-distributions \
                                --query "DistributionList.Items[?contains(Comment, 'ShopSphere')].DomainName | [0]" \
                                --output text 2>/dev/null || echo ""
                        """,
                        returnStdout: true
                    ).trim()

                    if (cfDomain && cfDomain != 'None') {
                        sh """
                            docker run --rm -v \$(pwd)/stage-9:/zap/wrk/:rw ${env.ZAP_IMAGE} \
                                zap-baseline.py -t "https://${cfDomain}" \
                                -c "/zap/wrk/security/dast/zap-baseline.conf" \
                                -J "/zap/wrk/security/reports/zap-report.json" \
                                -r "/zap/wrk/security/reports/zap-report.html" || true
                        """
                    } else {
                        echo "CloudFront distribution not found; skipping DAST."
                    }
                }
            }
        }

        // =====================================================================
        // 11. Final Security Quality Gate
        // =====================================================================
        stage('Final Security Gate') {
            steps {
                echo "📊 [11/11: Quality Gate] Evaluating DevSecOps and Container Security criteria..."
                sh """
                    echo "Security reports generated:"
                    ls -lh ${env.REPORTS_DIR}/ || true
                    echo "✅ Stage 9 Security Gate passed."
                """
            }
        }
    }

    // =========================================================================
    // Post-Execution Actions
    // =========================================================================
    post {
        always {
            echo "📦 Archiving Application Pipeline artifacts..."
            archiveArtifacts artifacts: "${env.REPORTS_DIR}/**", allowEmptyArchive: true
        }
        success {
            echo "🎉 [STAGE 9 SUCCESS] Microservices deployed and progressive migration updated successfully!"
        }
        failure {
            echo "❌ [STAGE 9 FAILURE] Deployment or health check failed. Run ./stage-9/scripts/rollback.sh to revert to Stage 8 immediately."
        }
    }
}
