// ShopSphere Stage 9 - Application Pipeline v2
// Uses Jenkins integrations for Node, Docker/ECR, AWS credentials and Kubernetes access.
// The old deploy.sh / health-check.sh / migrate-traffic.sh / rollback.sh scripts are not used.

pipeline {
  agent any

  parameters {
    choice(name: 'MIGRATION_WEIGHT', choices: ['100-0','90-10','75-25','50-50','25-75','0-100'], description: 'Blue(Stage 8)-Green(Stage 9) weights for the catch-all rule.')
    booleanParam(name: 'ENABLE_PRODUCT_PATH', defaultValue: false, description: 'Enable /api/products* ALB rule through the infrastructure pipeline.')
    booleanParam(name: 'ENABLE_ORDER_PATH', defaultValue: false, description: 'Enable /api/orders* ALB rule through the infrastructure pipeline.')
    booleanParam(name: 'ENABLE_USER_PATH', defaultValue: false, description: 'Enable /api/users* ALB rule through the infrastructure pipeline.')
    booleanParam(name: 'RUN_DAST', defaultValue: true, description: 'Run ZAP baseline after deployment.')
    string(name: 'DAST_URL', defaultValue: 'https://REPLACE_WITH_STAGE9_URL', description: 'Application URL used by the DAST stage.')
  }

  environment {
    AWS_REGION = 'us-east-1'
    AWS_DEFAULT_REGION = 'us-east-1'
    EKS_CLUSTER = 'shopsphere-stage9-eks'
    NAMESPACE = 'shopsphere-stage9'
    REPORT_DIR = 'stage-9/security/reports'
    FRONTEND_REPO = 'shopsphere-stage9-frontend'
    PRODUCT_REPO = 'shopsphere-stage9-product'
    ORDER_REPO = 'shopsphere-stage9-order'
    USER_REPO = 'shopsphere-stage9-user'
    INFRA_JOB = 'stage-9-infra'
    NODE_IMAGE = 'node:20-alpine'
  }

  options {
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    ansiColor('xterm')
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Version') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
          env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
          env.RELEASE_TAG = "v9.${BUILD_NUMBER}-${env.GIT_COMMIT.take(8)}"
          env.FRONTEND_IMAGE = "${env.ECR_REGISTRY}/${env.FRONTEND_REPO}:${env.RELEASE_TAG}"
          env.PRODUCT_IMAGE = "${env.ECR_REGISTRY}/${env.PRODUCT_REPO}:${env.RELEASE_TAG}"
          env.ORDER_IMAGE = "${env.ECR_REGISTRY}/${env.ORDER_REPO}:${env.RELEASE_TAG}"
          env.USER_IMAGE = "${env.ECR_REGISTRY}/${env.USER_REPO}:${env.RELEASE_TAG}"
        }
        echo "Immutable release: ${env.RELEASE_TAG}"
      }
    }

    stage('Unit Tests') {
      steps {
        sh '''
          docker run --rm -v $(pwd):/workspace -w /workspace node:20-alpine \
            sh -c "for s in frontend product order user; do echo \\"Running unit tests for \\$s...\\" && (cd stage-9/services/\\$s && npm test); done"
        '''
      }
    }

    stage('SAST / SCA / Secrets') {
      parallel {
        stage('Semgrep') {
          steps {
            script {
              sh '''
                mkdir -p stage-9/security/reports
                docker run --rm -v $(pwd):/src returntocorp/semgrep:latest \
                  semgrep scan --config /src/stage-9/security/sast/.semgrep.yaml --json --output /src/stage-9/security/reports/semgrep.json /src/stage-9/services || true
              '''
            }
          }
        }
        stage('Gitleaks') {
          steps {
            script {
              sh '''
                mkdir -p stage-9/security/reports
                docker run --rm -v $(pwd):/repo zricethezav/gitleaks:latest \
                  detect --source=/repo --report-format=json --report-path=/repo/stage-9/security/reports/gitleaks.json --redact || true
              '''
            }
          }
        }
        stage('Trivy FS') {
          steps {
            script {
              sh '''
                mkdir -p stage-9/security/reports
                docker run --rm -v $(pwd):/workspace aquasec/trivy:latest \
                  fs --severity HIGH,CRITICAL --format sarif --output /workspace/stage-9/security/reports/trivy-fs.sarif /workspace/stage-9/services || true
              '''
            }
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'stage-9/security/reports/*', allowEmptyArchive: true }
      }
    }

    stage('Build, Scan & Push Images') {
      steps {
        script {
          if (!env.AWS_ACCOUNT_ID || env.AWS_ACCOUNT_ID == 'null') {
            env.AWS_ACCOUNT_ID = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
          }
          env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
          if (!env.RELEASE_TAG || env.RELEASE_TAG == 'null') {
            env.RELEASE_TAG = "v9.${BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : 'manual'}"
          }
          sh "aws ecr get-login-password --region ${env.AWS_REGION} | docker login --username AWS --password-stdin ${env.ECR_REGISTRY}"
          def images = [
            [repo: env.FRONTEND_REPO, context: 'stage-9/services/frontend'],
            [repo: env.PRODUCT_REPO, context: 'stage-9/services/product'],
            [repo: env.ORDER_REPO, context: 'stage-9/services/order'],
            [repo: env.USER_REPO, context: 'stage-9/services/user']
          ]
          images.each { item ->
            def fullImage = "${env.ECR_REGISTRY}/${item.repo}:${env.RELEASE_TAG}"
            sh "docker build -t ${fullImage} ${item.context}"
            sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v \$(pwd):/workspace aquasec/trivy:latest image --severity HIGH,CRITICAL --format sarif --output /workspace/stage-9/security/reports/${item.repo}.sarif ${fullImage} || true"
            sh "docker push ${fullImage}"
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'stage-9/security/reports/*', allowEmptyArchive: true }
      }
    }

    stage('Import Infrastructure Outputs') {
      steps {
        sh """
          mkdir -p stage-9/terraform
          if [ -f "../${env.INFRA_JOB}/stage-9/terraform/stage9-outputs.json" ]; then
            cp "../${env.INFRA_JOB}/stage-9/terraform/stage9-outputs.json" stage-9/terraform/stage9-outputs.json
          elif [ -f "/var/lib/jenkins/workspace/${env.INFRA_JOB}/stage-9/terraform/stage9-outputs.json" ]; then
            cp "/var/lib/jenkins/workspace/${env.INFRA_JOB}/stage-9/terraform/stage9-outputs.json" stage-9/terraform/stage9-outputs.json
          elif [ -d "/var/lib/jenkins/jobs/${env.INFRA_JOB}/builds" ]; then
            LAST_BUILD=\$(awk '\$1=="lastSuccessfulBuild"{print \$2}' "/var/lib/jenkins/jobs/${env.INFRA_JOB}/builds/permalinks")
            if [ -n "\$LAST_BUILD" ] && [ -f "/var/lib/jenkins/jobs/${env.INFRA_JOB}/builds/\$LAST_BUILD/archive/stage-9/terraform/stage9-outputs.json" ]; then
              cp "/var/lib/jenkins/jobs/${env.INFRA_JOB}/builds/\$LAST_BUILD/archive/stage-9/terraform/stage9-outputs.json" stage-9/terraform/stage9-outputs.json
            fi
          fi
          test -f stage-9/terraform/stage9-outputs.json || { echo "stage9-outputs.json not found!"; exit 1; }
        """
        script {
          def outputs = readJSON file: 'stage-9/terraform/stage9-outputs.json'
          env.EKS_CLUSTER = outputs.eks_cluster_name.value
          env.LBC_ROLE_ARN = outputs.aws_load_balancer_controller_role_arn.value
          env.BLUE_GREEN_RULE_ARN = outputs.blue_green_listener_rule_arn.value
          env.STAGE8_TG_ARN = outputs.stage8_target_group_arn.value
          env.STAGE9_FRONTEND_TG_ARN = outputs.stage9_frontend_target_group_arn ? outputs.stage9_frontend_target_group_arn.value : (outputs.stage9_monolith_target_group_arn ? outputs.stage9_monolith_target_group_arn.value : '')
          env.STAGE9_MONOLITH_TG_ARN = env.STAGE9_FRONTEND_TG_ARN
          env.STAGE9_PRODUCT_TG_ARN = outputs.stage9_product_target_group_arn.value
          env.STAGE9_ORDER_TG_ARN = outputs.stage9_order_target_group_arn.value
          env.STAGE9_USER_TG_ARN = outputs.stage9_user_target_group_arn.value
          env.ORDER_SQS_ROLE_ARN = outputs.order_service_sqs_role_arn.value
          env.DB_HOST = outputs.db_host.value
          env.REDIS_HOST = outputs.redis_host.value
          env.DB_NAME = outputs.db_name.value
          env.DB_USER = outputs.db_user.value
          env.SQS_QUEUE_URL = outputs.sqs_queue_url.value
        }
      }
    }

    stage('Render Kubernetes Manifests') {
      steps {
        script {
          if (!env.AWS_ACCOUNT_ID || env.AWS_ACCOUNT_ID == 'null') {
            env.AWS_ACCOUNT_ID = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
          }
          env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
          if (!env.RELEASE_TAG || env.RELEASE_TAG == 'null') {
            env.RELEASE_TAG = "v9.${BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : 'manual'}"
          }
          env.FRONTEND_IMAGE = "${env.ECR_REGISTRY}/${env.FRONTEND_REPO}:${env.RELEASE_TAG}"
          env.PRODUCT_IMAGE = "${env.ECR_REGISTRY}/${env.PRODUCT_REPO}:${env.RELEASE_TAG}"
          env.ORDER_IMAGE = "${env.ECR_REGISTRY}/${env.ORDER_REPO}:${env.RELEASE_TAG}"
          env.USER_IMAGE = "${env.ECR_REGISTRY}/${env.USER_REPO}:${env.RELEASE_TAG}"

          sh 'rm -rf build-dist && mkdir -p build-dist/kubernetes'
          def files = findFiles(glob: 'stage-9/kubernetes/**/*.yaml')
          files.each { f ->
            def text = readFile(f.path)
            text = text.replace('${FRONTEND_IMAGE}', env.FRONTEND_IMAGE)
                         .replace('${PRODUCT_IMAGE}', env.PRODUCT_IMAGE)
                         .replace('${ORDER_IMAGE}', env.ORDER_IMAGE)
                         .replace('${USER_IMAGE}', env.USER_IMAGE)
                         .replace('${DB_HOST}', env.DB_HOST)
                         .replace('${REDIS_HOST}', env.REDIS_HOST)
                         .replace('${DB_NAME}', env.DB_NAME)
                         .replace('${DB_USER}', env.DB_USER)
                         .replace('${SQS_QUEUE_URL}', env.SQS_QUEUE_URL)
                         .replace('${STAGE9_FRONTEND_TG_ARN}', env.STAGE9_FRONTEND_TG_ARN)
                         .replace('${STAGE9_MONOLITH_TG_ARN}', env.STAGE9_FRONTEND_TG_ARN)
                         .replace('${STAGE9_PRODUCT_TG_ARN}', env.STAGE9_PRODUCT_TG_ARN)
                         .replace('${STAGE9_ORDER_TG_ARN}', env.STAGE9_ORDER_TG_ARN)
                         .replace('${STAGE9_USER_TG_ARN}', env.STAGE9_USER_TG_ARN)
                         .replace('${ORDER_SQS_ROLE_ARN}', env.ORDER_SQS_ROLE_ARN)
            writeFile file: "build-dist/kubernetes/${f.path.substring('stage-9/kubernetes/'.length())}", text: text
          }
        }
      }
    }

    stage('Create Runtime Secret') {
      steps {
        sh """
          aws eks update-kubeconfig --region ${env.AWS_REGION} --name ${env.EKS_CLUSTER}
          kubectl -n ${env.NAMESPACE} create namespace ${env.NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
          kubectl -n ${env.NAMESPACE} create secret generic shopsphere-db-credentials --from-literal=DB_PASSWORD="ShopSphere2026SecurePass!" --dry-run=client -o yaml | kubectl apply -f -
        """
      }
    }

    stage('Deploy EKS Workloads') {
      steps {
        sh """
          aws eks update-kubeconfig --region ${env.AWS_REGION} --name ${env.EKS_CLUSTER}
          kubectl apply -f build-dist/kubernetes/namespaces/namespace.yaml
          kubectl apply -f build-dist/kubernetes/configmaps/app-config.yaml
          kubectl apply -f build-dist/kubernetes/frontend/
          kubectl apply -f build-dist/kubernetes/product-service/
          kubectl apply -f build-dist/kubernetes/order-service/
          kubectl apply -f build-dist/kubernetes/user-service/
          kubectl apply -f build-dist/kubernetes/ingress/target-group-binding.yaml
          kubectl -n ${env.NAMESPACE} rollout status deployment/frontend-service --timeout=5m
          kubectl -n ${env.NAMESPACE} rollout status deployment/product-service --timeout=5m
          kubectl -n ${env.NAMESPACE} rollout status deployment/order-service --timeout=5m
          kubectl -n ${env.NAMESPACE} rollout status deployment/user-service --timeout=5m
        """
      }
    }

    stage('Health Gate') {
      steps {
        sh """
          aws eks update-kubeconfig --region ${env.AWS_REGION} --name ${env.EKS_CLUSTER}
          kubectl -n ${env.NAMESPACE} get pods -o wide
          kubectl -n ${env.NAMESPACE} get endpoints frontend-service product-service order-service user-service
        """
      }
    }

    stage('Progressive Traffic') {
      steps {
        script {
          def parts = params.MIGRATION_WEIGHT.tokenize('-')
          def blue = parts[0]
          def green = parts[1]
          echo "Requesting infrastructure pipeline to set Blue=${blue}, Green=${green}"
          build job: env.INFRA_JOB, wait: true, propagate: true, parameters: [
            string(name: 'ACTION', value: 'apply'),
            booleanParam(name: 'AUTO_APPROVE', value: true),
            booleanParam(name: 'ENABLE_PRODUCT_PATH', value: params.ENABLE_PRODUCT_PATH),
            booleanParam(name: 'ENABLE_ORDER_PATH', value: params.ENABLE_ORDER_PATH),
            booleanParam(name: 'ENABLE_USER_PATH', value: params.ENABLE_USER_PATH),
            string(name: 'BLUE_WEIGHT', value: blue),
            string(name: 'GREEN_WEIGHT', value: green)
          ]
        }
      }
    }

    stage('DAST') {
      when { expression { params.RUN_DAST } }
      steps {
        script {
          sh '''
            docker run --rm -v $(pwd):/zap/wrk zaproxy/zap-stable:2.16.1 \
              zap-baseline.py -t ${params.DAST_URL} -r /zap/wrk/stage-9/security/reports/zap.html -J /zap/wrk/stage-9/security/reports/zap.json || true
          '''
        }
      }
      post { always { archiveArtifacts artifacts: 'stage-9/security/reports/zap.*', allowEmptyArchive: true } }
    }
  }

  post {
    success { echo "Stage 9 application deployment completed for ${RELEASE_TAG}." }
    failure { echo 'Stage 9 application pipeline failed. Keep Stage 8 at its current traffic level and do not increase Green traffic.' }
  }
}
