pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to perform on Stage-3 (ALB + Auto Scaling Group + Multi-EC2 + Amazon RDS)'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual confirmation before apply or destroy'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_DIR           = 'stage-3/terraform'
        TF_IMAGE         = 'hashicorp/terraform:latest'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo "🚀 Checking out ShopSphere Stage 3 repository..."
                git branch: 'main', url: 'https://github.com/vinodk11/shopsphere-aws-scaling.git'
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                echo "🔧 Running terraform init & validate via Docker container for Stage-3 (ALB + ASG + RDS)..."
                sh """
                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} version

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} init -input=false

                    docker run --rm \
                        -v \$(pwd):/workspace \
                        -w /workspace/${env.TF_DIR} \
                        --net=host \
                        ${env.TF_IMAGE} validate
                """
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        echo "⚠️ Generating DESTROY plan for Stage-3..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -destroy -out=tfplan -input=false
                        """
                    } else {
                        echo "📋 Generating execution plan for Stage-3..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} plan -out=tfplan -input=false
                        """
                    }
                }
            }
        }

        stage('Approval Gate') {
            when {
                expression { 
                    return (params.ACTION == 'apply' || params.ACTION == 'destroy') && !params.AUTO_APPROVE 
                }
            }
            steps {
                script {
                    def actionText = params.ACTION == 'destroy' ? 'DESTROY' : 'APPLY'
                    input(
                        id: 'TerraformApproval',
                        message: "Review the plan above. Proceed with Terraform ${actionText} on Stage-3 (ALB + ASG + Amazon RDS)?",
                        ok: "Proceed with ${actionText}"
                    )
                }
            }
        }

        stage('Terraform Apply / Destroy') {
            when {
                expression { return params.ACTION == 'apply' || params.ACTION == 'destroy' }
            }
            steps {
                script {
                    if (params.ACTION == 'apply') {
                        echo "🚀 Applying Stage-3 infrastructure (ALB + ASG + Amazon RDS) via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    } else if (params.ACTION == 'destroy') {
                        echo "💥 Destroying Stage-3 infrastructure via Docker..."
                        sh """
                            docker run --rm \
                                -v \$(pwd):/workspace \
                                -w /workspace/${env.TF_DIR} \
                                --net=host \
                                ${env.TF_IMAGE} apply -input=false tfplan
                        """
                    }
                }
            }
        }

        stage('Smoke Test & ALB Verification') {
            when {
                expression { return params.ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_DIR}") {
                    echo "🩺 Verifying Stage-3 Storefront & Application Load Balancer..."
                    sh '''
                        ALB_DNS=$(terraform output -raw alb_dns_name 2>/dev/null || grep -o '"alb_dns_name": *"[^"]*"' terraform.tfstate | head -n1 | cut -d '"' -f4 || true)

                        if [ -z "$ALB_DNS" ] || [ "$ALB_DNS" = "null" ]; then
                            echo "⚠️ Could not parse ALB DNS name, skipping health test."
                            exit 0
                        fi

                        HEALTH_URL="http://${ALB_DNS}/health"
                        echo "Target ALB Health Check: $HEALTH_URL"
                        echo "Waiting for ASG instances to register and pass Target Group health checks..."

                        ATTEMPTS=0
                        MAX_ATTEMPTS=30
                        SUCCESS=0

                        until [ $ATTEMPTS -ge $MAX_ATTEMPTS ]; do
                            RES=$(curl -s "$HEALTH_URL" || true)
                            if echo "$RES" | grep -q '"status":"UP"'; then
                                echo "✅ Stage-3 ALB is UP and routing healthy traffic!"
                                echo "$RES"
                                SUCCESS=1
                                break
                            else
                                echo "⏳ Attempt $((ATTEMPTS+1))/$MAX_ATTEMPTS: Waiting for ASG bootstrap & ALB target registration (15s)..."
                                sleep 15
                                ATTEMPTS=$((ATTEMPTS+1))
                            fi
                        done

                        if [ $SUCCESS -ne 1 ]; then
                            echo "❌ ALB Health check timed out after 7.5 minutes."
                            exit 1
                        fi

                        echo "🧪 Testing Round-Robin Load Balancing across ASG fleet..."
                        for i in $(seq 1 6); do
                            curl -s "http://${ALB_DNS}/api/instance-info" | grep -o '"hostname":"[^"]*"' || true
                            sleep 0.5
                        done
                    '''
                }
            }
        }
    }

    post {
        always {
            dir("${env.TF_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo "🎉 ShopSphere Stage-3 ${params.ACTION.toUpperCase()} completed successfully!"
        }
        failure {
            echo "❌ ShopSphere Stage-3 Pipeline failed. Check console output."
        }
    }
}
