# ==============================================================================
# ShopSphere Stage 3 - Sample Terraform Configuration Variables
# Copy to terraform.tfvars and customize for your environment.
# ==============================================================================

# AWS Region to deploy into
aws_region   = "us-east-1"
project_name = "shopsphere"
environment  = "stage3"

# VPC Networking Configuration
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# Explicit Availability Zones (leave commented to dynamically pick first 2 AZs)
# availability_zones = ["us-east-1a", "us-east-1b"]

# Administrator CIDRs for SSH access (Restrict to your IP for production)
admin_cidr = ["0.0.0.0/0"]

# EC2 Compute & Auto Scaling Group Configuration
instance_type              = "t3.micro"
root_volume_size           = 20
asg_min_size               = 2
asg_max_size               = 4
asg_desired_capacity       = 2
asg_target_cpu_utilization = 70.0

# Optional EC2 SSH Key Pair name
# ssh_key_name = "my-aws-keypair"

# Application Settings
app_port     = 8080
app_repo_url = "https://github.com/vinodk11/shopsphere-aws-scaling.git"

# Amazon RDS PostgreSQL Configuration
db_name                     = "shopspheredb"
db_user                     = "shopsphere_user"
db_password                 = "ShopSphere2026SecurePass!"
db_engine_version           = "15.7"
db_instance_class           = "db.t3.micro"
db_allocated_storage        = 20
db_max_allocated_storage    = 100
db_multi_az                 = false
db_skip_final_snapshot      = true
db_backup_retention_period  = 7
